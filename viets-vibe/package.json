{
  "name": "viets-vibe",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "format": "prettier --write app tests scripts playwright.config.ts next.config.ts ../README.md docs",
    "typecheck": "next typegen && tsc --noEmit",
